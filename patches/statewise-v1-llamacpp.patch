+        GGML_ASSERT(!up_exps_b && !gate_exps_b && !down_exps_b && "statewise: per-expert biases not supported in split path");
+        GGML_ASSERT(type_op == LLM_FFN_SILU && "statewise: only SILU/swiglu cold chain supported");
+        ggml_tensor * mh = ggml_repeat_4d(ctx0, sw->map_hot,  1, n_expert, n_tokens, 1);
