@@ -1468,6 +1471,31 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
         probs = ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens);
     }
 
+    // statewise expert cache: decode-only split into a GPU hot chain (per-layer cache
+    // tensors, misses -> dummy zero slot) and a CPU cold chain (sentinel ids -> skipped).
+    // Prompt processing (n_tokens > 8) keeps the dense path unchanged.
