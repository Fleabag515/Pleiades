+++ b/include/llama.h
@@ -499,6 +499,13 @@ extern "C" {
 
     LLAMA_API void llama_model_free(struct llama_model * model);
 
+    // statewise expert cache (Pleiades): populate a per-layer GPU hot-expert cache from a
+    // routing-profile file ("<il> <K> <e0>..<e{K-1}>" per line). Must be called after the
+    // model's tensors are loaded (i.e. after llama_model_load_from_file returns). Returns
+    // false on failure. Equivalent to setting LLAMA_STATEWISE_MAP before load. Static (v1):
+    // the cache is fixed for the lifetime of the model. See docs Phase 7.
+    LLAMA_API bool llama_model_statewise_init(struct llama_model * model, const char * path_map);
+
     LLAMA_API struct llama_context * llama_init_from_model(
                      struct llama_model * model,
             struct llama_context_params   params);
