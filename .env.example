# Copy to .env and fill in. NEVER commit .env.

# --- Vault ---
# Master key for the per-profile encrypted vaults. If unset, Pleiades generates
# ~/.pleiades/master.key (mode 0600). Losing this key loses ALL stored secrets.
PLEIADES_MASTER_KEY=

# --- Anamnesis (memory proxy) control API ---
PLEIADES_ANAMNESIS_CONTROL_URL=http://127.0.0.1:9000

# --- Our inference engine (in-process llama.cpp OpenAI-compatible server) ---
# Path to the GGUF model Pleiades serves. Any GGUF supported by llama.cpp works.
PLEIADES_MODEL_PATH=/path/to/model.gguf
# Host/port the in-process inference server binds to. Anamnesis upstream points here.
PLEIADES_INFERENCE_HOST=127.0.0.1
PLEIADES_INFERENCE_PORT=8080
# Context window and GPU offload. "auto" plans the GPU/CPU split from detected
# hardware at launch; -1 offloads all layers; 0 forces CPU.
PLEIADES_N_CTX=8192
PLEIADES_N_GPU_LAYERS=auto
# Optional: a chat format hint for llama.cpp (e.g. chatml, llama-3, qwen). Leave blank to auto-detect.
PLEIADES_CHAT_FORMAT=

# Anamnesis upstream.baseUrl is set automatically to the inference server above.
# Override only if you intentionally point a character at a different OpenAI-compatible backend.
PLEIADES_BACKEND_BASE_URL=
PLEIADES_BACKEND_API_KEY=

# --- Web search ---
PLEIADES_SEARXNG_URL=http://127.0.0.1:8888
