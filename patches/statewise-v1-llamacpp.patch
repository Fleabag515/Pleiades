diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 8b7acafda..5d131cdd9 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -1615,6 +1615,14 @@ static void ggml_compute_forward_mul_mat_id(
             for (int id = 0; id < n_ids; ++id) {
                 const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
 
+                // statewise: id < 0 marks an expert slot owned by another device (the GPU hot
+                // cache). Zero this dst row so the hot+cold add stays correct, then skip grouping
+                // it into the CPU work list. See src/llama-graph.cpp build_moe_ffn split path.
+                if (i02 < 0) {
+                    memset((char *) dst->data + id*nb1 + iid1*nb2, 0, ne0*sizeof(float));
+                    continue;
+                }
+
                 assert(i02 >= 0 && i02 < n_as);
 
                 MMID_MATRIX_ROW(i02, matrix_row_counts[i02]) = (struct mmid_row_mapping) {id, iid1};
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 4df1b9308..ebae45739 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -2473,6 +2473,18 @@ static void ggml_cuda_mul_mat_id(ggml_backend_cuda_context & ctx, ggml_tensor *
     const ggml_tensor * src1 = dst->src[1];
     const ggml_tensor * ids  = dst->src[2];
 
+    // statewise placement tripwire (mirrors the ggml-vulkan guard). A cold-side
+    // mul_mat_id carries op_params[0]==1 and can contain sentinel ids (-1) that
+    // only the CPU backend knows how to skip. Such a node must never reach a GPU
+    // kernel -- CUDA mmid would read -1 as an out-of-range expert index and read
+    // out of bounds, silently corrupting output. If this fires, the cold experts
+    // were not pinned to CPU (e.g. n_cpu_moe did not cover the cached layers):
+    // fix placement, do NOT add a -1 skip here (Ion measured the shader-side skip
+    // at ~11% global cost and rejected it; the cold side is owned by the CPU).
+    if (dst->op_params[0] == 1) {
+        GGML_ABORT("statewise: sentinel-bearing mul_mat_id scheduled on CUDA - cold experts not pinned to CPU (placement bug)");
+    }
+
     GGML_ASSERT(src1->type == GGML_TYPE_F32);
     GGML_ASSERT(dst->type  == GGML_TYPE_F32);
     GGML_ASSERT(!ggml_backend_buft_is_cuda_split(src0->buffer->buft) && "mul_mat_id does not support split buffers");
